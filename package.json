{
  "name": "announcement-prayer-player",
  "version": "3.0.0",
  "private": true,
  "description": "Audio Pengumuman Otomatis - IT Rayhan Hospital",
  "author": "IT Rayhan Hospital",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win nsis --x64 --ia32 --publish never"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "id.rayhan.announcement",
    "productName": "Announcement IT Rayhan",
    "artifactName": "Announcement IT Rayhan v3.0.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules",
      "!**/node_modules/**"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "icon": "desktop/build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Announcement IT Rayhan"
    }
  },
  "overrides": {
    "postcss": "8.5.31",
    "zod": "4.6.7"
  }
}
